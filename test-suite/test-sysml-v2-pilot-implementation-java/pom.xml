<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>sysmlv2.tests</groupId>
  <artifactId>test-sysml-v2-pilot-implementation-java</artifactId>
  <version>0.0.0</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- locally built Pilot Implementation: the fat jar from `mvn package` -->
    <pilot.dir>${project.basedir}/../../SysMLv2-Pilot-Implementation</pilot.dir>
    <pilot.jar>${pilot.dir}/org.omg.sysml.interactive/target/org.omg.sysml.interactive-0.64.0-SNAPSHOT-all.jar</pilot.jar>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.omg.sysml</groupId><artifactId>pilot-all</artifactId><version>local</version>
      <scope>system</scope><systemPath>${pilot.jar}</systemPath>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.11.4</version><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId><artifactId>gson</artifactId><version>2.11.0</version><scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version>
        <configuration>
          <systemPropertyVariables>
            <libraryPath>${pilot.dir}/sysml.library</libraryPath>
            <resultsDir>${env.RESULTS_DIR}</resultsDir>
            <dataDir>${project.basedir}/../data</dataDir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
