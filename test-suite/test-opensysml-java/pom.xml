<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>sysmlv2.tests</groupId>
  <artifactId>test-opensysml-java</artifactId>
  <version>0.0.0</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- the OpenSysML Java client built from the local checkout and installed into the
         local repository (`mvn -f OpenSysML/client/java/pom.xml install`); the test
         checks that the jar on the class path is that build, not a released one -->
    <opensysml.version>0.12.1</opensysml.version>
    <opensysml.dir>${project.basedir}/../../OpenSysML</opensysml.dir>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.openmbee</groupId><artifactId>opensysml</artifactId><version>${opensysml.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.11.4</version><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId><artifactId>gson</artifactId><version>2.11.0</version><scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version>
        <configuration>
          <systemPropertyVariables>
            <opensysmlDir>${opensysml.dir}</opensysmlDir>
            <opensysmlVersion>${opensysml.version}</opensysmlVersion>
            <resultsDir>${env.RESULTS_DIR}</resultsDir>
            <dataDir>${project.basedir}/../data</dataDir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
